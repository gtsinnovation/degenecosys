# Copy to .env and set the required secrets before starting the stack.
POSTGRES_PASSWORD=
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=
# Comma-separated Solana public keys permitted to administer contests and payouts.
ADMIN_WALLETS=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
