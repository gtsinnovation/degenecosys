# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://degen_admin:replace-with-a-long-random-database-password@db:5432/degen_ecosystem_db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=replace-with-at-least-64-hex-characters
# Comma-separated Solana public keys permitted to administer contests and payouts.
ADMIN_WALLETS=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
